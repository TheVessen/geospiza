<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net7.0;net48</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <NoWarn>NU1701;NETSDK1086</NoWarn>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <WebAssetRoot>$(MSBuildThisFileDirectory)EmbeddedAssets\web\</WebAssetRoot>
    </PropertyGroup>

    <!-- Windows-specific configuration -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4'))">
        <UseWindowsForms>true</UseWindowsForms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
        <PackageReference Include="System.Resources.Extensions" Version="5.0.0"/>
    </ItemGroup>

    <!-- MacOS-specific references -->
    <ItemGroup Condition="!($(TargetFramework.Contains('-windows')) or $(TargetFramework.StartsWith('net4')))">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" ExcludeAssets="all" GeneratePathProperty="true"/>
        <Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)\build\.NETFramework\v4.8\System.Windows.Forms.dll" Private="False"/>
        <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime"/>
    </ItemGroup>

    <!-- Legacy resources for Build() / HtmlTemplates (standalone HTML snippet path) -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\charthopper-viewer.html" />
        <EmbeddedResource Include="Resources\charthopper.js" />
    </ItemGroup>

    <!--
        Build both web pipelines, then embed the SvelteKit output.

        1. web/ (esbuild) → Resources/charthopper.js  — used by Build() / HtmlTemplates
        2. app/ (SvelteKit) → EmbeddedAssets/web/     — used by Open() / ChartHopperServer

        The SvelteKit ItemGroup is inside the Target so it evaluates AFTER npm runs,
        capturing fresh content-hashed filenames on every build.
    -->
    <!--
        Only run the npm builds once — gated on net48 — to avoid the multi-target
        parallel build racing to delete and write the same output directory at the
        same time (EBUSY). Both targets embed the same files; building once is enough.
    -->
    <ItemGroup>
        <WebSrc Include="$(MSBuildThisFileDirectory)app\src\**\*.*" />
        <WebSrc Include="$(MSBuildThisFileDirectory)app\package.json" />
        <WebSrc Include="$(MSBuildThisFileDirectory)web\src\**\*.*" />
        <WebSrc Include="$(MSBuildThisFileDirectory)web\package.json" />
    </ItemGroup>

    <Target Name="BuildWebPipelines" BeforeTargets="BeforeBuild"
            Condition="'$(TargetFramework)' == 'net48'"
            Inputs="@(WebSrc)"
            Outputs="$(WebAssetRoot)_app\version.json">
        <Message Text="Building ChartHopper legacy web package..." Importance="high" />
        <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)web" />
        <!-- RemoveDir here — before MSBuild opens any embedded files in either target -->
        <RemoveDir Directories="$(WebAssetRoot)" />
        <Message Text="Building ChartHopper SvelteKit app..." Importance="high" />
        <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)app" />
    </Target>

    <!-- Embed SvelteKit output — runs for every target after the files exist -->
    <Target Name="EmbedWebApp" BeforeTargets="BeforeBuild" AfterTargets="BuildWebPipelines">
        <ItemGroup>
            <_WebFile Include="$(WebAssetRoot)**\*.*" />
            <EmbeddedResource Include="@(_WebFile)">
                <LogicalName>ChartHopper.EmbeddedAssets.web.$([System.String]::Copy('%(_WebFile.RecursiveDir)').Replace('\','/').Replace('/','.'))%(_WebFile.Filename)%(_WebFile.Extension)</LogicalName>
            </EmbeddedResource>
        </ItemGroup>
    </Target>

</Project>
